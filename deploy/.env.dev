# ============================================================
# 开发环境 (Docker 容器内) - 连接同 nacos-net 网络上的其他容器
# 所有 host 使用 Docker 容器名，端口使用容器内部端口
# ============================================================

# —— Nacos (容器名: nacos, 内部端口 8848) ——
NACOS_HOST=nacos
NACOS_PORT=8848

# —— MySQL (容器名: mysql8, 内部端口 3306) ——
MYSQL_HOST=mysql8
MYSQL_PORT=3306
MYSQL_DATABASE=lease
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# —— Redis (容器名: redis, 内部端口 6379) ——
REDIS_HOST=redis
REDIS_PORT=6379

# —— MinIO (如果也在 nacos-net 上，填入容器名; 否则留空走默认) ——
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=lease
