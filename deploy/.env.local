# ============================================================
# 本地开发环境 - 连接 192.168.100.101 上的服务
# 用于本地 IDEA 直接启动，或 docker compose 使用宿主机网络时
# ============================================================

# —— Nacos ——
NACOS_HOST=192.168.100.101
NACOS_PORT=8848

# —— MySQL ——
MYSQL_HOST=192.168.100.101
MYSQL_PORT=3306
MYSQL_DATABASE=lease
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# —— Redis ——
REDIS_HOST=192.168.100.101
REDIS_PORT=6379

# —— MinIO ——
MINIO_ENDPOINT=http://192.168.100.101:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lease
