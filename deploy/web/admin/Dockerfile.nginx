FROM nginx:alpine

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 干掉官方 entrypoint，避免它覆盖配置
ENTRYPOINT []

# 删掉官方 nginx.conf 里的 pid 行（避免 duplicate），其他保持不变
RUN sed -i '/^pid.*nginx.pid;/d' /etc/nginx/nginx.conf

# 拷贝前端打包产物
COPY dist/ /usr/share/nginx/html/

# 拷贝我们的 server 块配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# daemon off 前台运行，pid 用 -g 单独指定到 /tmp
CMD ["nginx", "-g", "daemon off; pid /tmp/nginx.pid;"]
